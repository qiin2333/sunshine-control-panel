node_modules
dist
build

.vscode
.idea

# Rust / Cargo
src-tauri/target/
# NOTE: src-tauri/Cargo.lock 必须跟踪 — sunshine-gui 是 binary crate，
# 不锁 lock 会让 CI 每次 fresh checkout 重新拉最新依赖，跨 release 行为漂移。
# v0.3.22 release 触发 Tauri ACL false-reject 的 root cause 即此：CI 拉到的
# tauri/tauri-plugin-* 比开发时新，新 plugin 自动注入 __app-acl__ permission
# 让 ACL gate 启用，而本地 build 用旧 lock 复现不出。

# Tauri 构建产物
src-tauri/gen/
src-tauri/WixTools/

# build.rs 自动生成的 capability（每次编译重写，避免 review noise）
src-tauri/capabilities/*.generated.json
# tauri-build AppManifest::commands 自动生成的 permission TOML
src-tauri/permissions/autogenerated/

# 图标生成文件（如果使用自动生成）
src-tauri/icons/*.png
!src-tauri/icons/32x32.png
!src-tauri/icons/128x128.png
!src-tauri/icons/128x128@2x.png

# Installer 构建产物
src-tauri/installer/staging/
src-tauri/installer/dist/