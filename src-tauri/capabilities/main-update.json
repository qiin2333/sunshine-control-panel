{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-update",
  "description": "Allows only the bundled main Control Panel window to manage updates.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-check-for-updates",
    "allow-check-for-updates-for-channel",
    "allow-start-update-checker-when-ui-ready",
    "allow-get-include-prerelease-preference",
    "allow-set-include-prerelease-preference",
    "allow-download-update",
    "allow-check-cached-update",
    "allow-install-update"
  ]
}
