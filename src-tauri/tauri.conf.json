{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunshine GUI",
  "version": "0.0.0-dev",
  "identifier": "com.212333.app",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http: https: data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https: http://127.0.0.1:* http://localhost:* https://localhost:*",
        "frame-src": "http://127.0.0.1:* http://localhost:* https://localhost:* about:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http: https: data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https: http://127.0.0.1:* http://localhost:* https://localhost:* ws://127.0.0.1:8080 ws://localhost:8080",
        "frame-src": "http://127.0.0.1:* http://localhost:* https://localhost:* about:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'"
      }
    },
    "withGlobalTauri": true
  }
}
